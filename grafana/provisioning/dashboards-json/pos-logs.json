{
  "title": "POS - Log tap trung (Loki)",
  "uid": "pos-logs",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "So dich vu dang UP",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "targets": [ { "refId": "A", "expr": "sum(up)", "legendFormat": "UP" } ] },
    { "id": 2, "type": "timeseries", "title": "So dong log moi giay theo dich vu",
      "datasource": "Loki",
      "gridPos": { "x": 6, "y": 0, "w": 9, "h": 5 },
      "targets": [ { "refId": "A", "expr": "sum by (service) (rate({service=~\".+\"}[2m]))", "legendFormat": "{{service}}" } ] },
    { "id": 3, "type": "timeseries", "title": "Dong log loi (error/fatal/critical) moi giay",
      "datasource": "Loki",
      "gridPos": { "x": 15, "y": 0, "w": 9, "h": 5 },
      "targets": [ { "refId": "A", "expr": "sum by (service) (rate({service=~\".+\", muc=~\"error|fatal|critical\"}[2m]))", "legendFormat": "{{service}}" } ] },
    { "id": 4, "type": "timeseries", "title": "Nginx - Request theo ma trang thai",
      "datasource": "Loki",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 7 },
      "targets": [ { "refId": "A", "expr": "sum by (status) (count_over_time({service=\"nginx\", status!=\"\"}[1m]))", "legendFormat": "{{status}}" } ] },
    { "id": 5, "type": "timeseries", "title": "Hoa don that bai (het hang) moi phut",
      "datasource": "Loki",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 7 },
      "targets": [ { "refId": "A", "expr": "sum(count_over_time({service=\"app\", muc=\"failed\"}[1m]))", "legendFormat": "failed" } ] },
    { "id": 6, "type": "logs", "title": "Log ung dung POS (app)",
      "datasource": "Loki",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 10 },
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [ { "refId": "A", "expr": "{service=\"app\"}" } ] },
    { "id": 7, "type": "logs", "title": "Log Nginx (access log)",
      "datasource": "Loki",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 10 },
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [ { "refId": "A", "expr": "{service=\"nginx\"}" } ] }
  ]
}
